{
  // All configure settings (build type, tests, Python/pybind11 paths, sanitizer
  // options) live in CMakePresets.json. Pick the preset in the CMake Tools
  // status bar: debug | profile | asan | tsan - each builds into build/<preset>,
  // so switching needs no rebuild. See Docs/Tooling.md.
  "cmake.useCMakePresets": "always",

  // IntelliSense takes include paths and defines from the active preset.
  "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools"
}
