{
  "cmake.environment": {
    "VIRTUAL_ENV": "${workspaceFolder}/.venv",
    "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}"
  },
  "cmake.configureSettings": {
    "Python_EXECUTABLE": "${workspaceFolder}/.venv/bin/python",
    "pybind11_DIR": "${workspaceFolder}/.venv/lib/python3.12/site-packages/pybind11/share/cmake/pybind11",
    // Build the Catch2 tests in the IDE build tree, so they show up in the Test
    // Explorer and the Run button on a TEST_CASE works. Without this the option
    // defaults to OFF, no CTestTestfile.cmake is generated, and CMake Tools
    // reports "ctest integration disabled" even though that setting is enabled.
    "HIK_BUILD_TESTS": "ON",
    // Also build the [hardware] tests. They SKIP cleanly when no camera is
    // connected (see core/tests/test_capture_hw.cpp).
    "HIK_ENABLE_HARDWARE_TESTS": "ON"
  },
  // Gives IntelliSense the real include paths (/opt/MVS/include) and defines
  // for the C++ sources. Regenerated by `cmake -S . -B build`.
  "C_Cpp.default.compileCommands": "${workspaceFolder}/build/compile_commands.json"
}