
# build files (one tree per CMake preset: build/<preset>, reports in build/reports)
build/
CMakeUserPresets.json

# analysis output that lands outside build/ when tools are run by hand
perf.data*
callgrind.out.*
cachegrind.out.*
vgcore.*

# Python / uv
.venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
wheelhouse/
*.so

# Captured images
snapshot.png
*.bmp
*.jpg
*.jpeg
*.tif
*.tiff

# HIK related files and folders
MVS-4.6.3_x86_64_20260205.tar.gz
note.txt
HiKCam_Samplesusw/

# HikRobot MVS packages and the SDK extracted from them by `uv run fetch_mvs`:
# proprietary, so never in git - only the README that explains them.
External/hik/*
!External/hik/README.md

