"""Type stubs for the compiled `uc2_cam_py._hik` extension module.

Hand-maintained so editors (VS Code / Pylance) show signatures on hover; keep
them in sync with bindings/hik_py.cpp. This is the low-level layer - use
`uc2_cam_py.create_camera` instead.
"""



import numpy as np

# --- Devices -----------------------------------------------------------------

class DeviceInfo:
    """Description of one enumerated HikRobot camera (read-only)."""

    @property
    def transport(self) -> str:
        """str: Transport layer, 'GigE' or 'USB3'."""
    @property
    def model_name(self) -> str:
        """str: Camera model name."""
    @property
    def serial(self) -> str:
        """str: Serial number."""
    @property
    def user_name(self) -> str:
        """str: User-defined name (may be empty)."""
    @property
    def ip(self) -> str:
        """str: Current IP (GigE only, else empty)."""

def list_devices(connection_type: str = "") -> list[DeviceInfo]:
    """Enumerate the connected HikRobot cameras ('USB3', 'GigE' or '' for both)."""

def initialize() -> bool:
    """Initialise the MVS SDK (done automatically on import)."""

def finalize() -> None:
    """Release the explicit SDK reference taken by initialize()."""

def run_connection_test(index: int = -1, frames: int = 0, snapshot: str = "", display: bool = True) -> int:
    """Quick connection test of a HikRobot camera; 0 ok, 2 no camera, 1 error."""

# --- Logging -----------------------------------------------------------------

def _set_log_forwarding(on: bool) -> None: ...
def _pop_log(timeout_ms: int = 200, max_items: int = 256) -> list[tuple[int, str]]: ...
def _wake_log() -> None: ...
def _log_dropped() -> int: ...
def _set_log_level(level: int) -> None: ...
def _emit_log(level: int, message: str) -> None: ...

# --- Images ------------------------------------------------------------------

class ImageHandle:
    """One pinned ring-buffer slot; keeps the ring memory alive."""

    @property
    def array(self) -> np.ndarray:
        """Read-only zero-copy view, (H, W) or (H, W, 3)."""
    @property
    def sequence(self) -> int: ...
    @property
    def slot(self) -> int: ...
    @property
    def ts_before_ns(self) -> int: ...
    @property
    def ts_after_ns(self) -> int: ...
    @property
    def nbytes(self) -> int: ...
    @property
    def address(self) -> int: ...
    def still_valid(self) -> bool: ...

# --- Cameras -----------------------------------------------------------------

class CameraBase:
    """Vendor-neutral camera core. Units: ms, fps, dB, unbinned sensor pixels."""

    @property
    def vendor(self) -> str: ...
    @property
    def model(self) -> str: ...
    @property
    def serial(self) -> str: ...
    @property
    def connection_type(self) -> str: ...
    @property
    def index(self) -> int: ...
    @property
    def is_running(self) -> bool: ...

    def can_set_exposure(self) -> bool: ...
    def can_set_gain(self) -> bool: ...
    def can_set_frame_rate(self) -> bool: ...
    def can_set_binning(self) -> bool: ...
    def can_set_trigger(self) -> bool: ...
    def can_set_roi(self) -> bool: ...

    def exposure_range_ms(self) -> tuple[float, float] | None: ...
    def frame_rate_range(self) -> tuple[float, float] | None: ...
    def gain_range_db(self) -> tuple[float, float] | None: ...
    def binning_values(self) -> list[int]: ...

    def get_exposure_ms(self) -> float | None: ...
    def get_frame_rate(self) -> float | None: ...
    def get_gain_db(self) -> float | None: ...
    def get_binning(self) -> int | None: ...
    def get_roi(self) -> tuple[int, int, int, int] | None: ...
    def sensor_size(self) -> tuple[int, int] | None: ...
    def image_size(self) -> tuple[int, int] | None: ...
    def pixel_format(self) -> int: ...
    def pixel_layout(self) -> tuple[bool, int, int, str]: ...

    def set_exposure_ms(self, ms: float) -> bool: ...
    def set_exposure_auto(self) -> bool: ...
    def set_frame_rate(self, fps: float) -> bool: ...
    def disable_frame_rate_limit(self) -> bool: ...
    def set_gain_db(self, db: float) -> bool: ...
    def set_gain_auto(self) -> bool: ...
    def set_binning(self, factor: int) -> bool: ...
    def set_roi(self, x: int, y: int, width: int, height: int) -> bool: ...
    def reset_roi(self) -> bool: ...
    def last_change_restarted(self) -> bool: ...

    def set_buffer_config(self, slot_count: int, storage_path: str, comment: str) -> None: ...
    def start(self) -> bool: ...
    def stop(self) -> None: ...
    def close(self) -> None: ...

    def read_latest(self) -> ImageHandle | None: ...
    def read_slot(self, slot: int) -> ImageHandle | None: ...
    def slot_count(self) -> int: ...
    def session_header(self) -> dict | None: ...
    def recording_file(self) -> str: ...
    def frames_written(self) -> int: ...
    def frames_rejected(self) -> int: ...
    def stream_stats(self) -> tuple[int, int, bool]: ...

class HikCamera(CameraBase):
    """HikRobot (MVS) camera."""

    def __init__(self, connection_type: str = "", serial: str = "", index: int = -1) -> None: ...

class SimCamera(CameraBase):
    """Simulated camera producing a walking Gaussian spot."""

    def __init__(
        self,
        serial: str = "SIM-0001",
        connection_type: str = "USB3",
        pixel_format: str = "Mono16",
        sensor_width: int = 1920,
        sensor_height: int = 1200,
        frame_rate: float = 10.0,
    ) -> None: ...
    def spot_position(self, sequence: int) -> tuple[float, float]: ...
    def exposure_auto(self) -> bool: ...
    def gain_auto(self) -> bool: ...

# --- Preview window ------------------------------------------------------------

class ImageWindow:
    """Minimal X11 window showing 8-bit grey images."""

    def __init__(self, width: int, height: int, title: str) -> None: ...
    @property
    def is_valid(self) -> bool: ...
    @property
    def close_requested(self) -> bool: ...
    def pump_events(self) -> bool: ...
    def show_gray8(self, image: np.ndarray) -> bool: ...
    @staticmethod
    def display_supported() -> bool: ...
